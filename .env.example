# 阶段 2 集成模块只消费进程环境；不会自动加载本文件或 .env。
# 显式启动示例：uv run --env-file .env python main.py
# 大模型（OpenAI 兼容协议）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Tavily 联网搜索
TAVILY_API_KEY=

# 内部知识库（本地向量检索）；本地目录须包含 config.json 和 modules.json。
# build_knowledge_base.py 拒绝覆盖已有 VECTOR_STORE_DIR，请使用新目录构建。
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_MODEL_PATH=
KNOWLEDGE_BASE_DIR=./knowledge_base
VECTOR_STORE_DIR=./vector_store

# 数据库：仅应用只读账号；初始化管理员不要配置给 Agent。
# 本模块只消费进程环境变量，不自动加载 .env。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tanyuan_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=pharma_db
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15
MYSQL_QUERY_TIMEOUT_MS=10000
MYSQL_MAX_ROWS=200
MYSQL_MAX_RESULT_BYTES=1048576
